# What the source distribution carries beyond the package itself.
include LICENSE README.md GETTING_STARTED.md CONTRIBUTING.md ROADMAP.md
include requirements.txt requirements-dev.txt pytest.ini conftest.py
include setup.sh Makefile
include launch.py coach.py dashboard.py
recursive-include quantum_study *.md
recursive-include tests *.py
recursive-include tools *.py *.sh *.md *.json
recursive-include tools/webdeck *
global-exclude *.py[cod]
global-exclude .DS_Store
prune .venv
prune **/__pycache__
