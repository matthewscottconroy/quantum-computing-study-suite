# MANIFEST.in — extra files for the source distribution.
#
# setuptools already puts pyproject.toml, README.md, LICENSE and the three
# py-modules (launch.py, coach.py, dashboard.py) into the sdist.  This file adds
# the bootstrap and maintenance scripts so `pip download --no-binary :all:` gives
# something you can actually re-create the environment from.
#
# The ten PyQt6 apps, the docs corpus, lesson-plans, notebooks, labs and projects
# are deliberately NOT shipped: they are not Python packages (see the note at the
# top of pyproject.toml), they are large, and they are only useful inside a git
# checkout.  Get them from
# https://github.com/matthewscottconroy/quantum-computing-study-suite

include requirements.txt
include requirements-dev.txt
include pytest.ini
include setup.sh
include Makefile
include tools/run_tests.sh
include tools/verify_docs.py
include tools/README.md

# Never ship caches or the local virtualenv, whatever else matches above.
global-exclude *.py[cod]
global-exclude .DS_Store
prune .venv
prune **/__pycache__
include tools/export_cards.py
recursive-include tools/webdeck *
include tools/daily_nudge.sh tools/install_nudge.sh
